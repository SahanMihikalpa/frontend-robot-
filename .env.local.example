NEXT_PUBLIC_API_BASE_URL=http://adder-exciting-tarpon.ngrok-free.app

#http://localhost:8000 for development

# Optional — enables YouTube keyword search in the study-break "Rest video".
# Get a free key from Google Cloud (YouTube Data API v3) and restrict it by HTTP referrer.
# NEXT_PUBLIC_* is inlined into the browser bundle, so this key is public — the referrer
# restriction is what protects it. Leave empty to disable search (paste-a-link still works).
# NEXT_PUBLIC_YOUTUBE_API_KEY=your-youtube-data-api-key